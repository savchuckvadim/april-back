#!/bin/sh
#
# Предотправочная проверка: ловит то, из-за чего прод падает при старте.
#
# 27.08.2026 event-sales не поднялся (502) из-за забытого импорта модуля:
# юнит-тесты на моках такую ошибку не видят, а узнаём мы о ней уже из
# CI-деплоя. Здесь проверяются типы и DI-граф модулей.
#
# Пропустить осознанно: SKIP_PREFLIGHT=1 git push
if [ "$SKIP_PREFLIGHT" = "1" ]; then
    echo "pre-push: проверки пропущены (SKIP_PREFLIGHT=1)"
    exit 0
fi

echo "pre-push: проверяю типы и DI-граф модулей…"
npm run --silent check:preflight
status=$?
if [ $status -ne 0 ]; then
    echo ""
    echo "pre-push: ОТПРАВКА ОСТАНОВЛЕНА — проверки не прошли."
    echo "Почини ошибки выше или, если уверен, повтори с SKIP_PREFLIGHT=1."
fi
exit $status
