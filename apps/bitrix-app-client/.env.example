# ============================================================
# bitrix-app-client — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/bitrix-app-client/.env (реальный .env в gitignore).
#
# Сюда — ТОЛЬКО специфика приложения. Общие секреты (DB/Redis/Bitrix/JWT/SMTP)
# живут в корневом /.env и читаются всеми apps и libs (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=bitrix-app-client API
SWAGGER_DESCRIPTION=API установки и аккаунтов Bitrix24-приложения (legacy-мир)
SWAGGER_VERSION=1.0
