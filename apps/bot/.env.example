# ============================================================
# bot — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/bot/.env (реальный .env в gitignore).
#
# Назначение приложения: каналы общения с пользователями (Bitrix-бот и
# Telegram-бот). Знают сценарии и кнопки, собирают предданные и отправляют их
# в профильные приложения. Пока это рабочие шаблоны без полной бизнес-логики.
#
# Сюда — ТОЛЬКО специфика приложения (например, токены ботов). Общие секреты
# (DB/Redis/Bitrix) живут в корневом /.env (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=bot API
SWAGGER_DESCRIPTION=API ботов общения с пользователями (bot)
SWAGGER_VERSION=1.0

# Токен Telegram-бота (заполнить реальным значением в apps/bot/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# Мониторинг линии поддержки (@lib/support, крон SupportMonitorScheduler).
# Включается в админке: портал линии → «Портал (общие)» → «Поддержка».
# Отдельный Telegram-бот поддержки (BotFather) и групповой чат, куда он
# добавлен: все участники чата получают клиентские сигналы. Это НЕ бот
# тревог разработчика (TELEGRAM_BOT_TOKEN). Пусто — только колокольчик.
# chat id группы — отрицательное число (см. getUpdates бота).
# ------------------------------------------------------------
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# Support API (/api/support/*) для техспециалиста и ИИ (MCP april-support).
# Ключи через запятую: имя:ключ. Пусто — API закрыт. Не путать с
# AGENT_API_KEYS: Support API умеет писать клиентам в линию.
# ------------------------------------------------------------
SUPPORT_API_KEYS=

# ------------------------------------------------------------
# Приём команд Telegram-ботом поддержки (ИИ-помощник): «что в поддержке»,
# «разбери …», кнопка «Отправить клиенту». Полный публичный адрес вебхука,
# например https://api.bot.april-app.ru/api/support/telegram/webhook, и
# секрет (случайная строка). bot при старте сам регистрирует вебхук в
# Telegram (кроме APP_ROLE=standby). Пусто — бот только шлёт оповещения.
# Модель — шлюз LLM: VibeCode-ключ портала линии (админка → портал → ключи).
# ------------------------------------------------------------
SUPPORT_TELEGRAM_WEBHOOK_URL=
SUPPORT_TELEGRAM_WEBHOOK_SECRET=
