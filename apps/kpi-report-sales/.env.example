# ============================================================
# kpi-report-sales — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/kpi-report-sales/.env (реальный .env в gitignore).
#
# Сюда — ТОЛЬКО специфика приложения. Общие секреты (DB/Redis/Bitrix и пр.)
# живут в корневом /.env и читаются всеми apps и libs (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=kpi-report-sales API
SWAGGER_DESCRIPTION=API приложения kpi-report-sales
SWAGGER_VERSION=1.0

# Portal-context сессия фрейма Bitrix24 (@lib/auth): guard мутирующих ручек
# ai-analytics (settings/save, feedback, cache/reset, push, rop-mark/save,
# plan/daily, brief, manager/style) сверяет Bearer с domain/requesterUserId тела.
#   off     — проверок нет;
#   report  — нарушения только в лог, запросы проходят (выкатка бэка раньше фронта);
#   enforce — 401/403. Включать после того, как фронт kpi-sales шлёт токен.
# Секрет подписи — общий AUTH_JWT_SECRET (или APP_SECRET_KEY) из корневого .env.
PORTAL_SESSION_GUARD_MODE=report
