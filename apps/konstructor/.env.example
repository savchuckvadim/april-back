# ============================================================
# konstructor — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/konstructor/.env (реальный .env в gitignore).
#
# Сюда — ТОЛЬКО специфика приложения. Общие секреты (DB/Redis/Bitrix и пр.)
# живут в корневом /.env и читаются всеми apps и libs (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=konstructor API
SWAGGER_DESCRIPTION=API приложения konstructor
SWAGGER_VERSION=1.0

# ------------------------------------------------------------
# Подбор шаблонов документов из БД (contract_templates /
# supply_report_templates) вместо одного файла из storage.
# По умолчанию ВЫКЛЮЧЕНО: деплой ничего не меняет, пока не включить явно.
# Истина — только `true` или `1`; любая опечатка оставляет легаси-путь.
# Перед включением: засеять общий уровень
# (scripts/seed-common-document-templates.ts --apply) и проверить
# GET konstructor/templates/resolve/contract?domain=…&contractType=…
# ------------------------------------------------------------
USE_DB_CONTRACT_TEMPLATES=false
USE_DB_SUPPLY_REPORT_TEMPLATES=false
