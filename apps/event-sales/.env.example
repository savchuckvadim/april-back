# ============================================================
# event-sales — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/event-sales/.env (реальный .env в gitignore).
#
# Сюда — ТОЛЬКО специфика приложения. Общие секреты (DB/Redis/Bitrix и пр.)
# живут в корневом /.env и читаются всеми apps и libs (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=event-sales API
SWAGGER_DESCRIPTION=API приложения event-sales
SWAGGER_VERSION=1.0

# ============================================================
# AI-отчётность по звонкам (call-report + agent-gate)
# ============================================================

# Крон автоконвейера: 1 — включён, иначе выключен (kill-switch).
CALL_REPORT_CRON_ENABLED=0
# Allowlist доменов пилотных порталов через запятую.
CALL_REPORT_DOMAINS=
# Минимальная длительность звонка для анализа, сек (презентации первыми).
CALL_REPORT_MIN_DURATION_SEC=300
# Окно поиска звонков назад, часов (перекрывает 30-минутный тик с запасом).
CALL_REPORT_WINDOW_HOURS=25
# Максимум звонков в очередь за один скан домена (бюджет транскрибации).
CALL_REPORT_MAX_PER_RUN=10
# Таймаут одной job обработки звонка, мс.
CALL_REPORT_JOB_TIMEOUT_MS=2700000
# Порог реанимации зависших processing, минут.
CALL_REPORT_STALE_MINUTES=90
# Модель первичного анализа (gigachat | openai | ollama | fake).
CALL_REPORT_LLM_MODEL=gigachat
# Анализировать только менеджеров отдела продаж (bx-department). 0 — выключить фильтр.
CALL_REPORT_SALES_ONLY=1

# Маршрутизация транскрибации: auto — по длительности, yandex/vibecode — принудительно.
TRANSCRIPTION_PROVIDER=auto
# От какой длительности (сек) звонок уходит в Yandex (дорогой, надёжный на длинных).
TRANSCRIPTION_YANDEX_MIN_SEC=600

# Таймауты Vibecode (мс): транскрибация и анализ.
VIBECODE_TRANSCRIBE_TIMEOUT_MS=600000
VIBECODE_ANALYSIS_TIMEOUT_MS=180000

# Ключи внешних агентов Agent API: имя:ключ[:domain1|domain2] через запятую.
# Домены — изоляция порталов: ключ видит только свои домены (мультиклиентский
# сервер агентов). Без доменов — полный доступ (только доверенный оркестратор).
# Пример: AGENT_API_KEYS=claw-gsr:hex64:gsr.bitrix24.ru,claw-garant:hex64:april-garant.bitrix24.ru
AGENT_API_KEYS=
