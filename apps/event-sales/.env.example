# ============================================================
# event-sales — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/event-sales/.env (реальный .env в gitignore).
#
# Сюда — ТОЛЬКО специфика приложения. Общие секреты (DB/Redis/Bitrix и пр.)
# живут в корневом /.env и читаются всеми apps и libs (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=event-sales API
SWAGGER_DESCRIPTION=API приложения event-sales
SWAGGER_VERSION=1.0

# ============================================================
# AI-отчётность по звонкам (call-report + agent-gate)
# ============================================================

# Крон автоконвейера: 1 — включён, иначе выключен (kill-switch).
# Боевой пример: CALL_REPORT_CRON_ENABLED=1
CALL_REPORT_CRON_ENABLED=0
# Allowlist доменов пилотных порталов через запятую.
# ДЕМО-режим портала: после домена через ':' — bitrix-id сотрудников
# (через '|'), чьи звонки анализировать; без суффикса — весь отдел продаж.
# Боевой пример: CALL_REPORT_DOMAINS=gsr.bitrix24.ru:323,april-garant.bitrix24.ru
CALL_REPORT_DOMAINS=
# Минимальная длительность звонка для анализа, сек (презентации первыми).
CALL_REPORT_MIN_DURATION_SEC=300
# Окно поиска звонков назад, часов (перекрывает 30-минутный тик с запасом).
CALL_REPORT_WINDOW_HOURS=25
# Максимум звонков в очередь за один скан домена (бюджет транскрибации).
CALL_REPORT_MAX_PER_RUN=10
# Таймаут одной job обработки звонка, мс.
CALL_REPORT_JOB_TIMEOUT_MS=2700000
# Порог реанимации зависших processing, минут.
CALL_REPORT_STALE_MINUTES=90
# Модель первичного анализа (gigachat | cloudru | openai | ollama | fake).
CALL_REPORT_LLM_MODEL=gigachat
# Анализировать только менеджеров отдела продаж (bx-department). 0 — выключить фильтр.
CALL_REPORT_SALES_ONLY=1
# Режим глубокого разбора: focus — многослойный (3 фокус-вызова «форма/
# содержание/движение сделки» + синтез: глубже и точнее, ~×1.5 вызовов);
# пусто/иное — цельный разбор одним вызовом.
CALL_REPORT_ANALYSIS_MODE=focus
# Создавать элемент смарта «AI-анализ звонков» по каждому обработанному звонку.
# Включено по умолчанию; 0 — крон доходит только до БД и таймлайна сделки/лида
# (так вело себя приложение до 31.07.2026: смарты появлялись лишь после ручного
# POST /call-report/analyze с createSmartItem=true).
CALL_REPORT_CRON_CREATE_SMART=1

# --- Ночной РЕВИЗОР (Фаза 3: свод по сущностям) ---
# Раз в сутки (23:30 МСК) проходит по сделкам/лидам с дневными разборами:
# невыполненные обещания, рекомендации по сделке, риски — в смарт-элемент и
# таймлайн. 1 — включён; по умолчанию ВЫКЛЮЧЕН (на каждую сущность — один
# дополнительный LLM-запрос). Ручной запуск: POST /call-report/revise.
CALL_REPORT_REVISOR_ENABLED=0
# Окно ревизии назад, часов (какие разборы считать «дневными»).
CALL_REPORT_REVISOR_WINDOW_HOURS=24
# Максимум сущностей за один ночной прогон (защита LLM-бюджета).
CALL_REPORT_REVISOR_MAX_ENTITIES=20
# Глубокий разбор звонка (7 разделов, спич, оценки) внутри конвейера.
# Раньше это присылал внешний агент-аналитик; с 31.07.2026 внешнего контура
# нет — разбор считает CallDeepAnalysisService по методичкам базы знаний
# (kind call-analysis-{тип звонка}). 0 — выключить шаг.
CALL_REPORT_DEEP_ANALYSIS_ENABLED=1

# Маршрутизация транскрибации: auto — по длительности, yandex/vibecode — принудительно.
TRANSCRIPTION_PROVIDER=auto
# От какой длительности (сек) звонок уходит в Yandex (дорогой, надёжный на длинных).
TRANSCRIPTION_YANDEX_MIN_SEC=600

# Таймауты Vibecode (мс): транскрибация и анализ.
VIBECODE_TRANSCRIBE_TIMEOUT_MS=600000
VIBECODE_ANALYSIS_TIMEOUT_MS=180000

# TLS сбер-шлюза GigaChat (ngw.devices.sberbank.ru подписан российским
# корневым сертификатом Минцифры — его нет в CA-бандле Node, без настройки
# авторизация падает с SELF_SIGNED_CERT_IN_CHAIN).
# Правильный путь: скачать Russian Trusted Root CA (PEM) и указать путь.
# GIGACHAT_CA_PATH=/app/certs/russian_trusted_root_ca.pem
# Быстрый обход (без проверки сертификата) — только как временная мера:
# GIGACHAT_INSECURE_TLS=1

# ---- Cloud.ru Evolution Foundation Models (CALL_REPORT_LLM_MODEL=cloudru) ----
# Открытые модели (Qwen3 и др.) в РФ-облаке, OpenAI-совместимый API, оплата
# за токены. Ключ — в личном кабинете Cloud.ru (Evolution AI Factory).
# ВАЖНО: брать только открытые модели, размещённые в РФ (Qwen, bge-m3);
# «внешние» модели каталога (Claude/GPT/Gemini) — прокси за рубеж.
# CLOUDRU_API_KEY=
# Endpoint по умолчанию: https://foundation-models.api.cloud.ru/v1
# (можно указать любой OpenAI-совместимый: vLLM на своём GPU, Yandex и т.п.)
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Id моделей в формате vendor/model — сверять с каталогом Cloud.ru.
# CLOUDRU_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# CLOUDRU_EMBEDDINGS_MODEL=BAAI/bge-m3
# Лимит одновременных запросов (RPS-лимиты Cloud.ru), по умолчанию 2.
# CLOUDRU_CONCURRENCY=2

# ---- Ключи внешних агентов Agent API (обязательно для /api/agent/*) ----
# Формат записи: имя:ключ[:domain1|domain2], записи через запятую.
#   имя    — метка агента, попадает в ais.provider и поле смарта «Имя агента»;
#   ключ   — случайный секрет (openssl rand -hex 32), агент шлёт его
#            заголовком x-agent-api-key;
#   домены — ИЗОЛЯЦИЯ ПОРТАЛОВ: ключ видит звонки/знания ТОЛЬКО этих доменов
#            (несколько — через |). Без доменов — полный доступ ко всем
#            порталам: только для доверенного общего оркестратора.
#
# в корневом

# --- Оптимизация AI-конвейера (2026-07-23) ---
# Параллельность воркера очереди CALL_REPORT (звонков одновременно).
CALL_REPORT_CONCURRENCY=3
# Резюме+рекомендации одним объединённым вызовом LLM (0 — два раздельных).
CALL_REPORT_COMBINED_ANALYSIS=1
# Дешёвая классификация типа звонка VibeCode в начале конвейера (0 — выкл).
CALL_REPORT_CLASSIFY_ENABLED=1
# Пер-провайдерные лимиты одновременных запросов.
TRANSCRIPTION_YANDEX_CONCURRENCY=2
TRANSCRIPTION_VIBECODE_CONCURRENCY=3
GIGACHAT_CONCURRENCY=2
# TTL Redis-кэша отчётов call-report-analytics, сек (default 3600).
CALL_REPORT_ANALYTICS_CACHE_TTL_SEC=3600
# Порог объединённого GigaChat-вызова (резюме+рекомендации одним запросом), симв.
# Длиннее — откат на map-reduce. НЕ путать с GIGACHAT_CHUNK_TRANSCRIPT_OVER_CHARS (900).
GIGACHAT_COMBINED_MAX_CHARS=12000
# Параллельность стадии ANALYZE (классификация+LLM); TRANSCRIBE — CALL_REPORT_CONCURRENCY.
CALL_REPORT_ANALYZE_CONCURRENCY=2
# Порог эскалации классификации: confidence ниже — тип перепроверяет агент.
CALL_REPORT_CLASSIFY_ESCALATION_CONFIDENCE=0.6
# Weekly-снапшоты профилей порталов (пн 03:15, домены из CALL_REPORT_DOMAINS).
CALL_REPORT_ANALYTICS_SNAPSHOT_ENABLED=0
