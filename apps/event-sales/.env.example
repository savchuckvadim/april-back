# ============================================================
# event-sales — переменные КОНКРЕТНОГО приложения (шаблон).
# Скопируйте в apps/event-sales/.env (реальный .env в gitignore).
#
# Сюда — ТОЛЬКО специфика приложения. Общие секреты (DB/Redis/Bitrix и пр.)
# живут в корневом /.env и читаются всеми apps и libs (ConfigModule isGlobal).
#
# Порт НЕ задаём здесь:
#   • локально (nest start)  — defaultPort из main.ts (переопределить можно PORT=...)
#   • в Docker               — внутренний 3000 задаёт compose, внешний host-порт
#                              централизован в infra/compose/ports.env
# ============================================================
GLOBAL_PREFIX=api
SWAGGER_PATH=docs/api
SWAGGER_TITLE=event-sales API
SWAGGER_DESCRIPTION=API приложения event-sales
SWAGGER_VERSION=1.0

# ============================================================
# AI-отчётность по звонкам (call-report + agent-gate)
#
# БИЗНЕС-НАСТРОЕК КОНВЕЙЕРА В ENV БОЛЬШЕ НЕТ (2026-08-04): включение
# порталов, пороги, модели, демо-режим, гейт нерелевантности, ночной
# ревизор — всё управляется из админки (карточка портала → вкладка AI,
# таблица portal_ai_settings) и применяется со следующего тика без деплоя.
# Здесь остались только ИНФРАСТРУКТУРНЫЕ параметры процесса (таймауты,
# параллельность, ключи внешних сервисов).
# ============================================================

# Таймаут одной job обработки звонка, мс.
CALL_REPORT_JOB_TIMEOUT_MS=2700000

# Маршрутизация транскрибации: auto — по длительности, yandex/vibecode — принудительно.
TRANSCRIPTION_PROVIDER=auto
# От какой длительности (сек) звонок уходит в Yandex (дорогой, надёжный на длинных).
TRANSCRIPTION_YANDEX_MIN_SEC=600
# Терпимость к сбоям Yandex SpeechKit: сколько ПОДРЯД временных ошибок (5xx/429/сеть)
# терпим на отправке аудио и на опросе результата, прежде чем сдаться (по умолчанию 5),
# и база паузы между повторами, мс (удваивается, потолок 30 с; по умолчанию 2000).
# YANDEX_STT_TRANSIENT_RETRIES=5
# YANDEX_STT_RETRY_BASE_MS=2000
# Опрос результата: пауза между опросами, мс (3000) и максимум опросов (700 ≈ 35 мин).
# YANDEX_STT_POLL_DELAY_MS=3000
# YANDEX_STT_POLL_MAX_ATTEMPTS=700

# Таймауты Vibecode (мс): транскрибация и анализ.
VIBECODE_TRANSCRIBE_TIMEOUT_MS=600000
VIBECODE_ANALYSIS_TIMEOUT_MS=180000

# ---- Whisper-совместимый сервис — третий транскрибатор (план устойчивости 28–29.10.2026) ----
# Любой OpenAI-совместимый /audio/transcriptions: свой сервер (faster-whisper-server,
# speaches, vLLM на GPU) или облако по ключу — OpenAI (https://api.openai.com/v1,
# модель whisper-1) и Groq (https://api.groq.com/openai/v1, whisper-large-v3-turbo);
# зарубежные хосты идут через исходящий прокси EGRESS_PROXY_* из корневого .env.
# Задан адрес — провайдер появляется в маршрутизации: последний резерв после
# Яндекса и VibeCode, либо основной при TRANSCRIPTION_PROVIDER=whisper. У портала
# может быть свой адрес/ключ (настройки AI портала в админке) — он важнее env.
# Адреса нет, а в корневом .env есть GROQ_API_KEY — общий резерв Groq включается сам.
# TRANSCRIPTION_WHISPER_BASE_URL=http://whisper:8000/v1
# TRANSCRIPTION_WHISPER_API_KEY=
# TRANSCRIPTION_WHISPER_MODEL=Systran/faster-whisper-large-v3
# TRANSCRIPTION_WHISPER_LANGUAGE=ru
# TRANSCRIPTION_WHISPER_TIMEOUT_MS=600000

# ---- Шлюз LLM (@lib/llm-gateway): кто считает разборы и чем подстраховаться ----
# Порядок провайдеров: vibecode (ключ портала из БД), openai-compatible (любой
# OpenAI-совместимый endpoint) и ai-rag (модели контура 1 — GigaChat/Cloud.ru/Ollama —
# со схемой в промпте; третий эшелон, по умолчанию не включён). Поменять местами —
# переключить основной без выкладки.
# LLM_PROVIDER_ORDER=vibecode,openai-compatible
# Модель третьего эшелона; не задана — llmModel портала, иначе gigachat.
# LLM_AI_RAG_MODEL=gigachat
# Запасной endpoint (креды портала llmBaseUrl/llmKey/llmModelName важнее env):
# Cloud.ru Evolution, Yandex AI Studio, vLLM/Ollama на своём GPU.
# Нет LLM_FALLBACK_* — берётся CLOUDRU_API_KEY (Cloud.ru), нет и его —
# GROQ_API_KEY из корневого .env (Groq, openai/gpt-oss-120b).
# LLM_FALLBACK_BASE_URL=https://foundation-models.api.cloud.ru/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# json_schema — строгая схема в response_format; json_object — только «верни JSON»,
# схема дописывается в промпт (модели без structured output).
# LLM_FALLBACK_JSON_MODE=json_schema
# LLM_FALLBACK_TIMEOUT_MS=180000
# Предохранитель: столько временных сбоев (5xx/429/сеть) за окно отключают провайдера
# на паузу — шлюз сразу идёт к запасному; переходы уходят в телеграм.
# LLM_CIRCUIT_FAILURES=5
# LLM_CIRCUIT_WINDOW_SEC=600
# LLM_CIRCUIT_COOLDOWN_SEC=300
# Запасная модель контура 1 (резюме/рекомендации, по умолчанию GigaChat): при
# ошибке основной — один повтор ею (gigachat / cloudru / openai / ollama).
# CALL_REPORT_LLM_FALLBACK_MODEL=cloudru
# Зарубежные endpoint'ы LLM/Whisper (OpenAI, Groq) и Telegram — через исходящий
# прокси: EGRESS_PROXY_URL / EGRESS_PROXY_TOKEN / EGRESS_PROXY_HOSTS в корневом .env.

# TLS сбер-шлюза GigaChat (ngw.devices.sberbank.ru подписан российским
# корневым сертификатом Минцифры — его нет в CA-бандле Node, без настройки
# авторизация падает с SELF_SIGNED_CERT_IN_CHAIN).
# Правильный путь: скачать Russian Trusted Root CA (PEM) и указать путь.
# GIGACHAT_CA_PATH=/app/certs/russian_trusted_root_ca.pem
# Быстрый обход (без проверки сертификата) — только как временная мера:
# GIGACHAT_INSECURE_TLS=1

# ---- Cloud.ru Evolution Foundation Models (CALL_REPORT_LLM_MODEL=cloudru) ----
# Открытые модели (Qwen3 и др.) в РФ-облаке, OpenAI-совместимый API, оплата
# за токены. Ключ — в личном кабинете Cloud.ru (Evolution AI Factory).
# ВАЖНО: брать только открытые модели, размещённые в РФ (Qwen, bge-m3);
# «внешние» модели каталога (Claude/GPT/Gemini) — прокси за рубеж.
# Ключ можно задать в админке («Настройки приложения») — он важнее env.
# CLOUDRU_API_KEY=
# Endpoint по умолчанию: https://foundation-models.api.cloud.ru/v1
# (можно указать любой OpenAI-совместимый: vLLM на своём GPU, Yandex и т.п.)
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Id моделей в формате vendor/model — сверять с каталогом Cloud.ru.
# CLOUDRU_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# CLOUDRU_EMBEDDINGS_MODEL=BAAI/bge-m3
# Лимит одновременных запросов (RPS-лимиты Cloud.ru), по умолчанию 2.
# CLOUDRU_CONCURRENCY=2

# ---- Ключи внешних агентов Agent API (обязательно для /api/agent/*) ----
# Формат записи: имя:ключ[:domain1|domain2], записи через запятую.
#   имя    — метка агента, попадает в ais.provider и поле смарта «Имя агента»;
#   ключ   — случайный секрет (openssl rand -hex 32), агент шлёт его
#            заголовком x-agent-api-key;
#   домены — ИЗОЛЯЦИЯ ПОРТАЛОВ: ключ видит звонки/знания ТОЛЬКО этих доменов
#            (несколько — через |). Без доменов — полный доступ ко всем
#            порталам: только для доверенного общего оркестратора.
#
# в корневом

# --- Инфраструктура AI-конвейера ---
# Параллельность воркера очереди CALL_REPORT (звонков одновременно).
CALL_REPORT_CONCURRENCY=3
# Параллельность стадии ANALYZE (классификация+LLM); TRANSCRIBE — CALL_REPORT_CONCURRENCY.
CALL_REPORT_ANALYZE_CONCURRENCY=2
# Пер-провайдерные лимиты одновременных запросов.
TRANSCRIPTION_YANDEX_CONCURRENCY=2
TRANSCRIPTION_VIBECODE_CONCURRENCY=3
GIGACHAT_CONCURRENCY=2
# TTL Redis-кэша отчётов call-report-analytics, сек (default 3600).
CALL_REPORT_ANALYTICS_CACHE_TTL_SEC=3600
# Порог объединённого GigaChat-вызова (резюме+рекомендации одним запросом), симв.
# Длиннее — откат на map-reduce. НЕ путать с GIGACHAT_CHUNK_TRANSCRIPT_OVER_CHARS (900).
GIGACHAT_COMBINED_MAX_CHARS=12000
# Weekly-снапшоты профилей (пн 03:15) идут по включённым порталам БД —
# отдельного флага нет.
