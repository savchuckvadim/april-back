# Настройки скриптов зеркала. Скопировать на сервер зеркала в
# /etc/mirror/mirror.env (chmod 600) — скрипты из infra/mirror/scripts
# подхватывают его сами (lib.sh). Это НЕ env приложений (тот — в Dokploy).

# Имя compose-проекта в Dokploy (= appName сервиса). Пусто — искать
# контейнеры по имени сервиса без привязки к проекту.
MIRROR_COMPOSE_PROJECT=
# Каталог files сервиса Dokploy (keys/, storage/, mysql/, redis/).
MIRROR_FILES_DIR=/etc/dokploy/compose/<appName>-<id>/files

# Реплика MySQL на зеркале (root — тот же, что MIRROR_MYSQL_ROOT_PASSWORD в Dokploy).
MIRROR_MYSQL_ROOT_PASSWORD=
# Пароль Redis зеркала, если включён requirepass (обычно пусто).
MIRROR_REDIS_PASSWORD=

# Прод-MySQL как источник репликации — адрес в сети WireGuard.
SOURCE_HOST=10.10.0.1
SOURCE_PORT=3306
SOURCE_DB=bitrix
# Учётка для первичного дампа (нужны SELECT, LOCK TABLES, SHOW VIEW,
# TRIGGER, EVENT на SOURCE_DB) — обычно root прода.
SOURCE_USER=root
SOURCE_PASSWORD=
# Пользователь репликации на проде (REPLICATION SLAVE).
REPL_USER=repl
REPL_PASSWORD=
# 1 — репликация по TLS (поверх WireGuard можно 0).
SOURCE_SSL=0

# Пользователь приложений на зеркале (создаётся при заливке, если задан).
# Пусто — приложения ходят root'ом (MIRROR_DATABASE_URL в Dokploy).
MIRROR_DB_APP_USER=
MIRROR_DB_APP_PASSWORD=

# Копия storage/ и keys/ прода (sync-storage.sh): SSH через WireGuard.
PROD_SSH=deploy@10.10.0.1
PROD_SSH_KEY=/etc/mirror/id_ed25519
PROD_DIR=/var/www/html/back-mono.april-app

# Контроль репликации (check-lag.sh).
MIRROR_MAX_LAG_SEC=60
# 1 — Redis зеркала обязан быть репликой (после фазы 3); 0 — пока мастер.
MIRROR_EXPECT_REDIS_REPLICA=0
MIRROR_STATE_FILE=/var/tmp/mirror-check.state
MIRROR_REMIND_HOURS=6

# Telegram вендора (те же значения, что в .env прода).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Ежедневный дамп с реплики (backup-dump.sh).
BACKUP_DIR=/var/backups/mirror-mysql
BACKUP_KEEP_DAYS=14
# Выгрузка в S3 (aws cli): пусто — только локально.
S3_BUCKET=
S3_PREFIX=mirror-mysql
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# Dokploy (dokploy-deploy.sh): панель, API-токен, id compose-сервиса.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_COMPOSE_ID=
