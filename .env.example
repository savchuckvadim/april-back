# ============================================================
# ОБЩИЙ .env монорепо (шаблон). Скопируйте в `.env` и заполните значения.
# Эти переменные общие для ВСЕХ приложений (apps/*). Специфичные для одного
# приложения (PORT, SWAGGER_*) — кладите в apps/<app>/.env (см. .env.example там).
# Реальные .env закоммичены НЕ будут (см. .gitignore).
# ============================================================

# ---- Окружение ----
NODE_ENV=production
# PORT здесь НЕ задаём — он у каждого приложения свой (apps/<app>/.env / compose)

# ---- Логирование (@lib/logger, общее для всех apps) ----
# Уровень: error | warn | log | debug | verbose | silent
# (дефолт: production -> log, иначе -> debug)
LOG_LEVEL=log
# false — полностью отключить логи (эквивалент LOG_LEVEL=silent)
LOGS_ENABLED=true
# error — дублировать ошибки в Telegram (через @lib/telegram); none — не слать.
# Точечно из кода (независимо от этой настройки): logger.warn('...', { telegram: true })
LOG_TELEGRAM_LEVEL=none

# ---- ClickHouse (хранилище логов; контейнер clickhouse из compose) ----
# ЛОКАЛЬНО (nest start + base-стек): http://localhost:8123.
# В docker (dev/prod) приложения получают http://clickhouse:8123 через
# environment в compose — он перекрывает это значение.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=logs
CLICKHOUSE_USER=default
# ПАРОЛЬ ОБЯЗАТЕЛЕН (и локально, и на проде): без CLICKHOUSE_PASSWORD образ
# ограничивает пользователя default только localhost'ом ВНУТРИ контейнера —
# ни приложения, ни хост подключиться не смогут (Authentication failed).
CLICKHOUSE_PASSWORD=
# true — писать логи в ClickHouse (батчами, fail-open: падение CH не роняет app)
LOG_CLICKHOUSE_ENABLED=false
# Тюнинг батчинга (опционально): интервал сброса, мс / размер батча
# LOG_CH_FLUSH_MS=5000
# LOG_CH_MAX_BATCH=500

# ---- Grafana (UI: метрики Prometheus + логи ClickHouse; docs/METRICS.md) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# ---- База данных (внешняя на проде; локально — контейнер db из compose) ----
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_PASSWORD=

# ---- Redis (общий для координации rate-limit/кэша между приложениями) ----
REDIS_HOST=
REDIS_PORT=6379

# ---- Bitrix / интеграции ----
APP_NAME=
APP_URL=
APP_SECRET_KEY=
CORS_ORIGIN=
ADMIN=
CLIENT_CABINET=
CLIENT_CABINET_URL=
AUTH_COOKIE_SPA_DOMAIN=
BITRIX_RATE_LIMIT_ENABLED=true
MISSED_CALLS_PORTAL_DOMAIN=

# ---- Авторизация (@lib/auth; общая для admin и pbx-install) ----
# Общий AUTH_JWT_SECRET для всех приложений → токен, выданный одним, валиден
# в другом (сквозной SSO). Менять auth можно «на лету» флагом AUTH_ENABLED.
# ВАЖНО: для admin-модерации маркетплейса (approve/block заявок) на проде
# AUTH_ENABLED=true обязателен — иначе @Roles(SUPER_USER) не защищает ручки.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=12h
# Учётные данные единственного администратора (SuperUser).
SUPERUSER_LOGIN=
# bcrypt-хэш пароля (НЕ открытый текст). Сгенерировать: pnpm run auth:hash -- 'пароль'
SUPERUSER_PASSWORD=

# placement-коды приложений Bitrix
EVENT_SALES_PLACEMENT=
EVENT_SERVICE_PLACEMENT=
KONSTRUCTOR_PLACEMENT=
REPORT_SALES_PLACEMENT=
REPORT_SERVICE_PLACEMENT=

# ---- API online ----
API_ONLINE_URL=
API_ONLINE_KEY=
API_ONLINE_ADMIN_URL=

# ---- LibreOffice / Gotenberg ----
LIBREOFFICE_MODE=
LIBREOFFICE_HTTP_URL=

# ---- Почта ----
MAIL_HOST=
MAIL_PORT=
MAIL_LOGIN=
MAIL_PASSWORD=

# ---- Telegram (опционально; фильтр уведомлений работает и без бота) ----
WITH_TELEGRAM=false
WITH_SCHEDLER=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHAT_BOT_TOKEN=
TELEGRAM_CHAT_MANAGER_CHAT_ID=
TELEGRAM_BRIDGE_WEBHOOK_URL=
BITRIX_IM_BRIDGE_DOMAINS=
BITRIX_IM_BRIDGE_IGNORE_BOTS=
BITRIX_IM_BRIDGE_IGNORE_SYSTEM=
BITRIX_IM_BRIDGE_POLL_LIMIT=
BITRIX_IM_BRIDGE_PORTAL_DENYLIST=
BITRIX_IM_BRIDGE_PORTAL_WHITELIST=
BITRIX_IM_BRIDGE_USER_EMAIL=

# ---- Yandex Object Storage (S3) ----
YA_ACCESS_KEY_ACCOUNT_ID=
YA_ACCESS_KEY_ID=
YA_ACCESS_KEY_KEY_ID=
YA_ACCESS_KEY_SECRET=
YA_BUCKET_NAME=
YA_FOLDER_ID=
YA_OAUTH=

# ---- Деплой (используется docker-compose.prod.yml) ----
GHCR_OWNER=
IMAGE_TAG=latest

# ---- Bitrix Marketplace («Менеджер Гарант», apps/pbx) ----
# Redirect после установки (iframe мастера установки)
MARKETPLACE_INSTALL_REDIRECT_URL=https://bitrix.april-app.ru/install
# Фронт основного приложения (кабинет, левое меню Битрикса)
MARKETPLACE_APP_REDIRECT_URL=https://bitrix.april-app.ru/cabinet
# Фронты виджетов живут на РАЗНЫХ доменах — цели redirect задаёт эталон-манифест
# (apps/pbx/src/marketplace/config/marketplace-manifest.ts, поле frontUrl).
# Подмена БЕЗ деплоя — env MARKETPLACE_WIDGET_URL_<КОД> (дефисы → подчёркивания):
# MARKETPLACE_WIDGET_URL_EVENT_SALES=https://front.april-app.ru/event/prod/placement.php
# MARKETPLACE_WIDGET_URL_KONSTRUCTOR=https://front.april-app.ru/konstructor/prod/placement.php
# MARKETPLACE_WIDGET_URL_REPORT_SALES=https://next.april-app.ru/kpi-sales/report
# Публичный URL этого API (HANDLER'ы event.bind/placement.bind)
MARKETPLACE_API_PUBLIC_URL=https://api.pbx.april-app.ru
# Ключ admin-эндпоинтов маркетплейса (X-Admin-Key); пусто = эндпоинты выключены
MARKETPLACE_ADMIN_KEY=123
# OAuth-креды приложения из кабинета вендора (рефреш токенов установок
# через oauth.bitrix24.tech). ИСТОЧНИК ИСТИНЫ — таблица bitrix_app_secrets
# (code=garant_manager; правится админкой: PUT /api/admin/bitrix-app-secrets/
# garant_manager). Env ниже — только ФОЛБЭК на случай пустой таблицы.
MARKETPLACE_CLIENT_ID=
MARKETPLACE_CLIENT_SECRET=
# MARKETPLACE_OAUTH_URL=https://oauth.bitrix24.tech/oauth/token/
# База pbx API для admin-модерации (approve → активация продукта в pbx);
# ключ — тот же MARKETPLACE_ADMIN_KEY (нужен и в env admin!)
PBX_API_URL=https://api.pbx.april-app.ru
# Предохранитель marketplace-детекта в PBXService (по умолчанию включён);
# false — все порталы ходят по legacy-пути (online-API + вебхук)
# PBX_MARKETPLACE_AUTH_FIRST=true
ADMIN_KEY=1DvKb8BqbWP

# ---- AI-отчётность по звонкам (event-sales: call-report + agent-gate) ----
# Полный блок настроек — apps/event-sales/.env.example (ConfigModule читает
# и корневой .env, поэтому значения можно держать и здесь).
#
# Ключи внешних агентов-аналитиков (OpenClaw): имя:ключ[:domain1|domain2].
# Ключ = случайный hex (openssl rand -hex 32), агент шлёт его заголовком
# x-agent-api-key. Домены — изоляция порталов (ключ видит только свои).
# Боевой пример (по ключу на клиента):
# AGENT_API_KEYS=claw-erger:34е:gsr.bitrix24.ru,claw-garant:34е34е:april-ergerg.bitrix24.ru
AGENT_API_KEYS=
# Крон автоконвейера (1 — вкл) и пилотные домены:
# CALL_REPORT_CRON_ENABLED=1
# CALL_REPORT_DOMAINS=erger.bitrix24.ru,april-ergerg.bitrix24.ru
